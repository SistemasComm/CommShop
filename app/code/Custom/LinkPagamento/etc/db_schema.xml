<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="custom_linkpagamento" resource="default" engine="innodb" comment="Custom Link Pagamento Table">
        <column name="id" xsi:type="int" nullable="false" identity="true" unsigned="true" comment="ID"/>
        <column name="sku" xsi:type="varchar" length="255" nullable="false" comment="SKU"/>
        <column name="quantity" xsi:type="int" nullable="false" comment="Quantity"/>
        <column name="price" xsi:type="decimal" scale="4" precision="12" nullable="false" comment="Price"/>
        <column name="hashurl" xsi:type="varchar" length="255" nullable="false" comment="Hash URL"/>
        <column name="created_at" xsi:type="timestamp" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column name="status" xsi:type="smallint" nullable="false" default="0" comment="Status"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
</schema>
