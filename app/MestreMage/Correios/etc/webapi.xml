<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
	<route method="GET" url="/V1/mestremage-correios/searchpostcode">
		<service class="MestreMage\Correios\Api\SearchPostCodeManagementInterface" method="getSearchPostCode"/>
		<resources>
			<resource ref="anonymous"/>
		</resources>
	</route>
	<route method="POST" url="/V1/mestremage-correios/importexport">
		<service class="MestreMage\Correios\Api\ImportexportManagementInterface" method="postImportexport"/>
		<resources>
			<resource ref="anonymous"/>
		</resources>
	</route>	
</routes>
