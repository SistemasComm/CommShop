// =========================================================================
//  Variables - Magento Luma Theme
// =========================================================================

// -------------------
//  Colors
// -------------------
@color-white: #ffffff;
@color-black: #000000;
@color-gray-dark: #303030;
@color-gray-middle: #666666;
@color-gray-light: #e6e6e6;
@color-gray-lighter: #f6f6f6;
@color-blue: #1979c3;
@color-blue-dark: #006bb4;
@color-orange: #f05725;
@color-red: #d40000;
@color-green: #008000;

// -------------------
//  Primary Colors
// -------------------
@primary__color: @color-blue;
@link__color: @color-blue;
@link__hover__color: @color-blue-dark;
@button__color: @color-white;
@button__background: @color-blue;
@button__hover__background: @color-blue-dark;

// -------------------
//  Typography
// -------------------
@font-family__base: 'Open Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
@font-family__serif: 'Georgia', serif;
@font-size__base: 14px;
@line-height__base: 1.4;
@font-weight__light: 300;
@font-weight__regular: 400;
@font-weight__bold: 700;

// -------------------
//  Layout
// -------------------
@layout__width: 1200px;
@layout__max-width: 1280px;
@layout-indent__width: 20px;
@layout__margin-bottom: 30px;

// -------------------
//  Breakpoints
// -------------------
@screen__xs: 480px;
@screen__s: 640px;
@screen__m: 768px;
@screen__l: 1024px;
@screen__xl: 1440px;

// -------------------
//  Header
// -------------------
@header__background-color: @color-white;
@header-panel__background-color: @color-gray-lighter;
@header-panel__text-color: @color-gray-dark;
@header__padding: 10px;

// -------------------
//  Navigation
// -------------------
@nav__background-color: @color-white;
@nav__font-size: 14px;
@nav__item-padding: 10px 15px;



//
//  Sidebar
//  ---------------------------------------------

@sidebar__background-color: @color-white-smoke; // Used in cart sidebar, Checkout sidebar, Tier Prices, My account navigation, Rating block background

//
//  Sidebar blocks
//  ---------------------------------------------

@block-items__counter__color: @color-gray43;
// -------------------
//  Cart (Mobile Specific)
// -------------------
@mobile-cart-padding: 15px; // Defines padding for cart on mobile devices
@cart__background-color: @color-white;
@cart-item__border-color: @color-gray-light;

// -------------------
//  Buttons
// -------------------
@button__font-size: 14px;
@button__padding: 10px 17px;
@button__border-radius: 3px;
@button-primary__background: @color-blue;
@button-primary__color: @color-white;
@button-primary__hover__background: @color-blue-dark;

// -------------------
//  Forms
// -------------------
@form-element-input__background: @color-white;
@form-element-input__border-color: @color-gray-middle;
@form-element-input__padding: 8px;

// -------------------
//  Footer
// -------------------
@footer__background-color: @color-gray-lighter;
@footer__text-color: @color-gray-dark;
@footer__padding: 20px;

// -------------------
//  Miscellaneous
// -------------------
@border-color__base: @color-gray-light;
@icon__color: @color-gray-dark;
@icon__font-size: 16px;
@loader__background: rgba(255, 255, 255, 0.7);
@loader__icon: url('../images/loader-1.gif');

// -------------------
//  Responsive Utilities
// -------------------
@mobile__padding: 15px;
@tablet__padding: 20px;
@desktop__padding: 30px;
